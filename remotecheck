    case $1/$2 in
        tcp/23) printf 'WARNING|Telnet sends credentials in plaintext' ;;
        tcp/512 | tcp/513 | tcp/514) printf 'WARNING|rsh/rlogin/rexec are plaintext and weakly authenticated' ;;
        udp/69) printf 'WARNING|TFTP has no authentication' ;;
        tcp/21) printf 'REVIEW|FTP sends credentials in plaintext unless FTPS is enforced' ;;
        tcp/79) printf 'REVIEW|Finger discloses user information' ;;
