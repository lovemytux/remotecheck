# detect_roles PROCESS_LINES PORTS
# Prints "role<TAB>confidence<TAB>evidence" for each matching rule.
detect_roles() {
    awk -F';;' -v ports=" $2 " '
        FNR == NR { procs[++np] = $0; next }
        NF < 3 { next }
        {
            role = $1; re = $2; pm = ""; pp = ""; cnt = 0
            if (re != "") for (i = 1; i <= np; i++) if (procs[i] ~ re) {
                split(procs[i], w, " "); nm = w[1]
                if (!((role, nm) in seen)) { seen[role, nm] = 1; if (cnt < 4) pm = pm (pm != "" ? ", " : "") nm; cnt++ }
            }
            if (cnt > 4) pm = pm ", ..."
            m = split($3, rp, " ")
            for (i = 1; i <= m; i++) if (index(ports, " " rp[i] " ")) pp = pp (pp != "" ? ", " : "") rp[i]
            if (pm != "" || pp != "") {
                ev = (pm != "") ? "process: " pm : ""
                if (pp != "") ev = ev (ev != "" ? "; " : "") "port: " pp
                print role "\t" ((pm != "") ? "high" : "medium") "\t" ev
            }
        }
    ' <(printf '%s\n' "$1") <(printf '%s\n' "$ROLE_RULES")
}

dmi() {
    local f=/sys/class/dmi/id/$1 v=''
    [[ -r $f ]] && read -r v <"$f" 2>/dev/null
    case $v in
        'To be filled by O.E.M.' | 'Default string' | 'System Product Name' | 'Not Specified' | None) v='' ;;
    esac
    printf '%s' "$v"
}

detect_platform() {
    local v='' c=''
    if have systemd-detect-virt; then
        c=$(systemd-detect-virt -c 2>/dev/null)
        v=$(systemd-detect-virt -v 2>/dev/null)
        [[ $c == none ]] && c=''
        if [[ -n $c && -n $v && $v != none ]]; then printf '%s (container) on %s (virtual machine)' "$c" "$v"; return; fi
        if [[ -n $c ]]; then printf '%s (container)' "$c"; return; fi
        if [[ -n $v && $v != none ]]; then printf '%s (virtual machine)' "$v"; return; fi
    fi
    if [[ -e /.dockerenv ]]; then printf 'docker (container)'; return; fi
    if [[ -e /run/.containerenv ]]; then printf 'podman (container)'; return; fi
    if grep -qE 'docker|kubepods|containerd|lxc' /proc/1/cgroup 2>/dev/null; then printf 'container'; return; fi
    if grep -q '^flags.* hypervisor' /proc/cpuinfo 2>/dev/null; then printf 'virtual machine'; return; fi
    if [[ $v == none ]]; then printf 'bare metal'; else printf 'bare metal (probably)'; fi
}

hardware_info() {
    local vendor product
    vendor=$(dmi sys_vendor)
    product=$(dmi product_name)
    printf '%s' "${vendor}${vendor:+${product:+ }}${product}"
}

cloud_provider() {
    local id
    id="$(dmi sys_vendor)|$(dmi product_name)|$(dmi bios_vendor)|$(dmi board_vendor)|$(dmi chassis_asset_tag)"
    case $id in
        *7783-7084-3265-9085-8269-3286-77*) printf 'Microsoft Azure' ;;
        *Amazon* | *EC2*) printf 'Amazon Web Services' ;;
        *Google*) printf 'Google Cloud' ;;
        *DigitalOcean*) printf 'DigitalOcean' ;;
        *Hetzner*) printf 'Hetzner' ;;
        *OracleCloud*) printf 'Oracle Cloud' ;;
        *Alibaba*) printf 'Alibaba Cloud' ;;
        *Tencent*) printf 'Tencent Cloud' ;;
        *Linode* | *Akamai*) printf 'Akamai (Linode)' ;;
        *Vultr*) printf 'Vultr' ;;
        *Scaleway*) printf 'Scaleway' ;;
        *OVH*) printf 'OVHcloud' ;;
        *Exoscale*) printf 'Exoscale' ;;
        *OpenStack*) printf 'OpenStack' ;;
